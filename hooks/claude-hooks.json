{
  "description": "Agent Workbench timeline and session context for Claude Code. hooks.json in this folder is the Cursor equivalent.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }]
      }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/agent-system/scripts/hook.py\"", "timeout": 20 }] }
    ]
  }
}
