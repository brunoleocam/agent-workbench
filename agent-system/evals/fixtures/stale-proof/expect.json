{
  "base": "complete-feature",
  "description": "Code changed after the proof: the gate fails until check_proofs runs again and the review is recorded for the new state.",
  "steps": [
    {
      "script": "check_proofs.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    },
    {
      "stamp": "docs/reviews/feat.md"
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    },
    {
      "write": "src/coupon.py",
      "content": "def apply(total, percent, expired):\n    return (total, 'COUPON_EXPIRED') if expired else (total - total * percent // 100, None)\n"
    },
    {
      "write": "docs/progress/CURRENT.md",
      "content": "# checkpoint\n"
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 1,
      "contains": [
        "TEST-001 proof predates the current workspace"
      ]
    },
    {
      "script": "check_proofs.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 1,
      "contains": [
        "Review was recorded for another workspace state"
      ],
      "not_contains": [
        "predates the current workspace"
      ]
    },
    {
      "stamp": "docs/reviews/feat.md"
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    }
  ]
}
