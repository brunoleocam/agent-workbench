      ]
    },
    {
      "script": "check_proofs.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0,
      "contains": [
        "[PASS] TEST-001",
        "[PASS] TEST-002"
      ]
    },
    {
      "script": "validate_tasks.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    },
    {
      "stamp": "docs/reviews/feat.md"
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0,
      "contains": [
        "Verification gate passed."
      ]
    }
  ]
}
