  "steps": [
    {
      "script": "validate_spec.py",
      "args": [
        "--feature",
        "feat",
        "--require-approval"
      ],
      "exit_code": 0
    },
    {
      "script": "validate_tasks.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 1,
