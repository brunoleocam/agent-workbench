{
  "base": "complete-feature",
  "description": "Known limit: a TEST that verifies nothing passes the structural gate. Only the reviewer's (manual) Verification Audit catches it.",
  "steps": [
    {
      "script": "check_proofs.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0
    },
    {
      "stamp": "docs/reviews/feat.md"
    },
    {
      "script": "validate_verification.py",
      "args": [
        "--feature",
        "feat"
      ],
      "exit_code": 0,
      "contains": [
        "Verification gate passed."
      ]
    }
  ]
}
